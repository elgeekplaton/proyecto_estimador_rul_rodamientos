              "\n",
              "        const docLinkHtml = 'Like what you see? Visit the ' +\n",
              "          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n",
              "          + ' to learn more about interactive tables.';\n",
              "        element.innerHTML = '';\n",
              "        dataTable['output_type'] = 'display_data';\n",
              "        await google.colab.output.renderOutput(dataTable, element);\n",
              "        const docLink = document.createElement('div');\n",
              "        docLink.innerHTML = docLinkHtml;\n",
              "        element.appendChild(docLink);\n",
              "      }\n",
              "    </script>\n",
              "  </div>\n",
              "\n",
              "\n",
              "    </div>\n",
              "  </div>\n"
            ],
            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "variable_name": "df"
            }
          },
          "metadata": {},
          "execution_count": 18
        }
      ],
      "source": [
        "print('=== Extrayendo features de vibración ===')\n",
        "df = pd.concat([process_bearing(n, f) for n, f in BEARINGS.items()], ignore_index=True)\n",
        "feat_cols = [c for c in df.columns if c[:2] in ('h_', 'v_')]\n",
        "print(df.groupby('bearing').size())\n",
        "df.head()\n"
      ],
      "id": "dNTL8D_c3tvJ"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "nwr4JZEb3tvJ"
      },
      "source": [
        "## 3. Health Indicator causal (PCA + K-Fold en la fase sana) y detección del FPT"
      ],
      "id": "nwr4JZEb3tvJ"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ie2VRzi83tvJ"
      },
      "outputs": [],
      "source": [
        "def health_indicator_causal(g, feat_cols, healthy_frac=HEALTHY_FRAC,\n",
        "                              n_components=N_COMPONENTS_HI, smooth=5):\n",
        "    \"\"\"\n",
        "    HI causal: el PCA se ajusta SOLO con la fase sana y se aplica hacia\n",
        "    adelante. Dentro de la fase sana se usa K-Fold para que el error de\n",
        "    reconstrucción sea comparable (evita el salto artificial de borde\n",
        "    que aparece si se evalúa el PCA sobre los mismos puntos con que se\n",
        "    entrenó). Ver README para la discusión sobre esta elección.\n",
        "    \"\"\"\n",
        "    g = g.sort_values('t').reset_index(drop=True)\n",
        "    X = g[feat_cols].values\n",
        "    n_h = max(int(len(X) * healthy_frac), 10)\n",
        "    n_comp = min(n_components, X.shape[1] - 1, n_h - 2)\n",
        "\n",
        "    sc = StandardScaler().fit(X[:n_h])\n",
        "    pca = PCA(n_components=n_comp, random_state=0).fit(sc.transform(X[:n_h]))\n",
        "\n",
        "    err = np.zeros(len(X))\n",
        "    if len(X) > n_h:\n",
        "        Z_rest = sc.transform(X[n_h:])\n",
        "        recon_rest = pca.inverse_transform(pca.transform(Z_rest))\n",
        "        err[n_h:] = np.mean((Z_rest - recon_rest) ** 2, axis=1)\n",
        "\n",
        "    n_splits = max(2, min(5, n_h // 3))\n",
        "    kf = KFold(n_splits=n_splits, shuffle=False)\n",
        "    for tr_idx, va_idx in kf.split(X[:n_h]):\n",
        "        sc_cv = StandardScaler().fit(X[tr_idx])\n",
        "        n_comp_cv = min(n_comp, len(tr_idx) - 1)\n",
        "        pca_cv = PCA(n_components=n_comp_cv, random_state=0).fit(sc_cv.transform(X[tr_idx]))\n",
        "        Zv = sc_cv.transform(X[va_idx])\n",
        "        rv = pca_cv.inverse_transform(pca_cv.transform(Zv))\n",
        "        err[va_idx] = np.mean((Zv - rv) ** 2, axis=1)\n",
        "\n",
        "    hi = pd.Series(err, index=g.index).rolling(smooth, min_periods=1).median()\n",
        "    base_mean, base_std = err[:n_h].mean(), err[:n_h].std() + 1e-9\n",
        "    hi_z = (hi - base_mean) / base_std\n",
        "\n",
        "    out = g[['bearing', 't', 'T', 'rul']].copy()\n",
        "    out['hi_raw'] = err\n",
        "    out['hi'] = hi\n",
        "    out['hi_z'] = hi_z\n",
        "    return out\n",
        "\n",
        "\n",
        "def detect_fpt(g, healthy_frac=HEALTHY_FRAC, mult=10, persist=8, min_umbral=1e-6):\n",
        "    \"\"\"Primer instante (First Predicting Time) donde el HI se desvía de forma\n",
        "    sostenida sobre su propia fase sana.\"\"\"\n",
        "    n_h = max(int(len(g) * healthy_frac), 10)\n",
        "    hi_z = g['hi_z'].clip(lower=0)\n",
        "    umbral = max(hi_z.iloc[:n_h].max(), min_umbral) * mult\n",
        "    above = hi_z > umbral\n",
        "    for i in range(n_h, len(above) - persist + 1):\n",
        "        if above.iloc[i:i + persist].all():\n",
        "            return g['t'].iloc[i]\n",
        "    return None\n"
      ],
      "id": "ie2VRzi83tvJ"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 576
        },
        "id": "TIAI_QHi3tvK",
        "outputId": "2dc8c0ed-7a28-4762-de69-510f6ba2b32d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=== Calculando Health Indicator (HI) y FPT ===\n",
            "  1_1 → FPT en t = 72\n",
            "  1_2 → FPT en t = 41\n",
            "  1_3 → FPT en t = 63\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 800x500 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "print('=== Calculando Health Indicator (HI) y FPT ===')\n",
        "hi_list = [health_indicator_causal(g, feat_cols) for _, g in df.groupby('bearing')]\n",
        "hi_df = pd.concat(hi_list, ignore_index=True)\n",
        "\n",
        "fpts = {}\n",
        "for b, g in hi_df.groupby('bearing'):\n",
        "    g = g.sort_values('t').reset_index(drop=True)\n",
        "    fpts[b] = detect_fpt(g)\n",
        "    print(f'  {b} → FPT en t = {fpts[b]}')\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 5))\n",
        "for b, g in hi_df.groupby('bearing'):\n",
        "    g = g.sort_values('t')\n",
        "    line, = ax.plot(g['t'], g['hi_z'], label=b)\n",
        "    if fpts[b] is not None:\n",
        "        ax.axvline(fpts[b], linestyle='--', alpha=0.6, color=line.get_color())\n",
        "ax.legend()\n",
        "ax.set_title('Health Indicator con FPT detectado')\n",
        "ax.set_xlabel('t (min)')\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
      "id": "TIAI_QHi3tvK"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Ts_8bvud3tvK"
      },
      "source": [
        "## 4. RUL con tope y filtrado post-FPT"
      ],
      "id": "Ts_8bvud3tvK"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "sx3IVdwg3tvK",
        "outputId": "46939d49-f835-410d-eaeb-b74d60c99e69"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=== Filas post-FPT por rodamiento ===\n",
            "bearing\n",
            "1_1     52\n",
            "1_2    121\n",
            "1_3     96\n",
            "dtype: int64\n"
          ]
        }
      ],
      "source": [
        "fpt_df = pd.DataFrame({'bearing': list(fpts.keys()), 'fpt': list(fpts.values())})\n",
        "df = df.merge(fpt_df, on='bearing', how='left')\n",
        "df['rul_capped'] = df['rul'].clip(upper=RUL_CAP)\n",
        "df_post_fpt = df[df['t'] >= df['fpt']].copy()\n",
        "print('=== Filas post-FPT por rodamiento ===')\n",
        "print(df_post_fpt.groupby('bearing').size())\n"
      ],
      "id": "sx3IVdwg3tvK"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "_9aZ3vMk3tvK"
      },
      "source": [
        "## 5. Selección de features para el regresor de RUL"
      ],
      "id": "_9aZ3vMk3tvK"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FX7tyzAG3tvK"
      },
      "outputs": [],
      "source": [
        "def select_features(train, cols, k=12, corr_max=0.95):\n",
        "    \"\"\"Elige `k` features monótonas con `t` (evaluadas en cada rodamiento de\n",
        "    train por separado, tomando el mínimo), descartando redundantes.\"\"\"\n",
        "    score = {}\n",
        "    for c in cols:\n",
        "        rhos = [abs(stats.spearmanr(g[c], g['t'])[0]) for _, g in train.groupby('bearing')]\n",
        "        score[c] = min(rhos)\n",
        "    ranked = sorted(score, key=score.get, reverse=True)\n",
        "    keep = []\n",
        "    for c in ranked:\n",
        "        if all(abs(train[c].corr(train[k_])) < corr_max for k_ in keep):\n",
        "            keep.append(c)\n",
        "        if len(keep) == k:\n",
        "            break\n",
        "    return keep\n"
      ],
      "id": "FX7tyzAG3tvK"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "JfAsFniI3tvK"
      },
      "source": [
        "## 6. Validación leave-one-bearing-out (Ridge vs. Random Forest)\n",
        "\n",
        "Resultado **informativo/comparativo**: en cada fold, un rodamiento queda\n",
        "totalmente fuera del entrenamiento. El modelo que finalmente se guarda\n",
        "(sección siguiente) usa un enfoque distinto (híbrido), que dio mejor\n",
        "desempeño auditado."
      ],
      "id": "JfAsFniI3tvK"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "p0QPfmfS3tvL",
        "outputId": "0182994e-8341-43f9-cdf3-d8de6a9b06bb"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=== Validación leave-one-bearing-out (Ridge vs. Random Forest) ===\n",
            "     n_features  MAE_ridge     MAE_rf\n",
            "1_1        12.0  32.829126  15.452991\n",
            "1_2        12.0  23.201810  27.946870\n",
            "1_3        12.0  16.451290  13.432914\n"
          ]
        }
      ],
      "source": [
        "print('=== Validación leave-one-bearing-out (Ridge vs. Random Forest) ===')\n",
        "resultados = {}\n",
        "for test_b in BEARINGS:\n",
        "    train = df_post_fpt[df_post_fpt.bearing != test_b].copy()\n",
        "    test = df_post_fpt[df_post_fpt.bearing == test_b].copy()\n",
        "    cols = select_features(train, feat_cols, k=12)\n",
        "\n",
        "    ridge = Ridge(alpha=1.0).fit(train[cols], train['rul_capped'])\n",
        "    rf = RandomForestRegressor(n_estimators=200, max_depth=5, random_state=0).fit(\n",
        "        train[cols], train['rul_capped'])\n",
        "\n",
        "    resultados[test_b] = {\n",
        "        'n_features': len(cols),\n",
        "        'MAE_ridge': mean_absolute_error(test['rul_capped'], ridge.predict(test[cols])),\n",
        "        'MAE_rf': mean_absolute_error(test['rul_capped'], rf.predict(test[cols])),\n",
        "    }\n",
        "\n",
        "tabla_resultados = pd.DataFrame(resultados).T\n",
        "print(tabla_resultados)\n"
      ],
      "id": "p0QPfmfS3tvL"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0uEsa6vX3tvL"
      },
      "source": [
        "## 7. Modelo final (híbrido) y guardado de `model.pkl`\n",
        "\n",
        "Se entrena con **1_1 y 1_3 completos** más el **70% inicial de 1_2**,\n",
        "dejando el 30% final de `1_2` como tramo genuinamente fuera de muestra\n",
        "(auditado, sin overlap de filas entre train y test)."
      ],
      "id": "0uEsa6vX3tvL"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9DWxRl7F3tvL",
        "outputId": "c7075383-d95e-4277-edd4-d7eedb734623"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "=== Entrenando el modelo final (híbrido, con 1_2 como unidad parcial) ===\n",
            "  Features finales: ['v_band4', 'v_band5', 'v_band2', 'v_band1', 'h_band1', 'h_p2p', 'h_band2', 'v_peak', 'h_band3', 'v_bpfo_h1', 'v_bpfo_sum', 'h_bpfo_h1']\n",
            "  MAE en 1_2 (tramo fuera de muestra, auditado): 6.21 min (10.3% sobre RUL_CAP=60)\n"
          ]
        }
      ],
      "source": [
        "print('=== Entrenando el modelo final (híbrido, con 1_2 como unidad parcial) ===')\n",
        "g_1_2 = df_post_fpt[df_post_fpt.bearing == '1_2'].sort_values('t').reset_index(drop=True)\n",
        "n_cut = int(len(g_1_2) * 0.7)\n",
        "train_1_2_part = g_1_2.iloc[:n_cut]\n",
        "test_1_2_part = g_1_2.iloc[n_cut:]\n",
        "\n",
        "train_final = pd.concat([\n",
        "    df_post_fpt[df_post_fpt.bearing == '1_1'],\n",
        "    df_post_fpt[df_post_fpt.bearing == '1_3'],\n",
        "    train_1_2_part,\n",
        "], ignore_index=True)\n",
        "\n",
        "cols_finales = select_features(train_final, feat_cols, k=12)\n",
        "print('  Features finales:', cols_finales)\n",
        "\n",
        "modelo_final = RandomForestRegressor(n_estimators=200, max_depth=5, random_state=0)\n",
        "modelo_final.fit(train_final[cols_finales], train_final['rul_capped'])\n",
        "\n",
        "mae_test_1_2 = mean_absolute_error(\n",
        "    test_1_2_part['rul_capped'], modelo_final.predict(test_1_2_part[cols_finales]))\n",
        "print(f'  MAE en 1_2 (tramo fuera de muestra, auditado): {mae_test_1_2:.2f} min '\n",
        "      f'({mae_test_1_2 / RUL_CAP * 100:.1f}% sobre RUL_CAP={RUL_CAP})')\n"
      ],
      "id": "9DWxRl7F3tvL"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "qBK5FpIJ3tvL",
        "outputId": "f96f3999-b369-425f-b3cc-d1bc115a2070"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Modelo guardado en /content/sample_data/model.pkl\n"
          ]
        }
      ],
      "source": [
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "paquete = {\n",
        "    'modelo': modelo_final,\n",
        "    'features': cols_finales,\n",
        "    'rul_cap': RUL_CAP,\n",
        "    'tipo_modelo': 'RandomForestRegressor',\n",
        "    'train_bearings': ['1_1', '1_3'],\n",
        "    'train_partial': {'bearing': '1_2', 't_max_train': int(train_1_2_part['t'].max())},\n",
        "    'test_bearing_partial': {'bearing': '1_2', 't_min_test': int(test_1_2_part['t'].min())},\n",
        "    'mae_auditado_test': round(mae_test_1_2, 2),\n",
        "}\n",
        "model_path = os.path.join(OUTPUT_DIR, 'model.pkl')\n",
        "joblib.dump(paquete, model_path)\n",
        "print(f'Modelo guardado en {model_path}')\n"
      ],
      "id": "qBK5FpIJ3tvL"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "YmWLnbTp3tvL"
      },
      "source": [
        "## 8. Generar `datos_muestra.csv` (train/test etiquetado)"
      ],
      "id": "YmWLnbTp3tvL"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bO8YQgSD3tvL",
        "outputId": "f8c306ec-fe33-4374-a0ce-6ff71400b2b7"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Muestra guardada en /content/sample_data/datos_muestra.csv\n",
            "split\n",
            "train    70\n",
            "test     30\n",
            "Name: count, dtype: int64\n",
            "bearing\n",
            "1_2    54\n",
            "1_3    33\n",
            "1_1    13\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ],
      "source": [
        "train_final_copy = train_final.copy()\n",
        "test_final = test_1_2_part.copy()\n",
        "train_final_copy['split'] = 'train'\n",
        "test_final['split'] = 'test'\n",
        "\n",
        "n_train_muestra = min(70, len(train_final_copy))\n",
        "n_test_muestra = min(30, len(test_final))\n",
        "muestra = pd.concat([\n",
        "    train_final_copy.sample(n_train_muestra, random_state=0),\n",
        "    test_final.sample(n_test_muestra, random_state=0),\n",
        "], ignore_index=True)\n",
        "\n",
        "columnas_finales = cols_finales + ['bearing', 't', 'rul', 'rul_capped', 'split']\n",
        "muestra = muestra[columnas_finales].sort_values(['split', 'bearing', 't']).reset_index(drop=True)\n",
        "\n",
        "muestra_path = os.path.join(OUTPUT_DIR, 'datos_muestra.csv')\n",
        "muestra.to_csv(muestra_path, index=False)\n",
        "print(f'Muestra guardada en {muestra_path}')\n",
        "print(muestra['split'].value_counts())\n",
        "print(muestra['bearing'].value_counts())\n"
      ],
      "id": "bO8YQgSD3tvL"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "eUKNy0dN3tvM"
      },
      "source": [
        "## 9. Fin del entrenamiento"
      ],
      "id": "eUKNy0dN3tvM"
    },
